---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/projects", label: "Projects" },
  { href: "/contact", label: "Contact" },
];
---

<header class="fixed top-4 inset-x-0 z-50 flex justify-center">
  <nav
    class="flex items-center gap-2 p-1.5 rounded-full border bg-white/80 dark:bg-neutral-900/80 backdrop-blur-md shadow-sm"
  >
    {
      navItems.map((item) => {
        // Check if current path matches, or starts with href for sub-pages like /blog/my-post
        const isActive =
          item.href === "/"
            ? currentPath === "/"
            : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            class:list={[
              "px-4 py-1.5 rounded-full text-sm font-medium transition-colors",
              isActive
                ? "active rounded-full shadow-sm"
                : "text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white",
            ]}
          >
            {item.label}
          </a>
        );
      })
    }
  </nav>
</header>

<style>
  a.active {
    color: white;
    background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      inset 0 -2px 0 rgba(0, 0, 0, 0.24);
  }

  a.active:hover {
    color: rgb(230, 230, 230);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      inset 0 -2px 0 rgba(0, 0, 0, 0.24);
  }
</style>
